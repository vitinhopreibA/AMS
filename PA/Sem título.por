programa {
  funcao inicio() {
    inteiro opcao

    escreva(" ### menu de venda ###", "\n")
    escreva("1- venda a vista","\n")
    escreva("2 - venda a prazo 30 dias","\n")
    escreva("3 - venda a prazo 60 dias","\n")
    escreva("4 - venda a prazo 60 dias","\n")
    escreva("5 - cartão de Débito"," \n")
    escreva("6 - cartão de Credito"," \n")
    escreva(" escolha uma opçao(1 a 6)","\n")
    leia(opcao)

    escolha(opcao){
      caso 1:
      escreva("você escolheu: venda á vista")
      pare
      caso 2:
    }
  }
}
